# Copy this file to .env and fill in your real values.
# .env is already covered by .gitignore — never commit real API keys.

# Required: your Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_key_here

# Optional: which model the tutor uses. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional: port for the backend server. Defaults to 3001.
PORT=3001

# Optional: Supabase configuration (Centralized database integration).
# If not set, the application automatically falls back to local JSON files in server/data/
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
